{
  "nftables": [
    {
      "metainfo": {
        "version": "1.1.3",
        "release_name": "Constructed Netlib input",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "ip",
        "name": "netlib_nat",
        "handle": 1
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "netlib_nat",
        "name": "prerouting",
        "handle": 1,
        "type": "nat",
        "hook": "prerouting",
        "prio": -100,
        "policy": "accept"
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "netlib_nat",
        "name": "postrouting",
        "handle": 2,
        "type": "nat",
        "hook": "postrouting",
        "prio": 100,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "netlib_nat",
        "chain": "prerouting",
        "handle": 3,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "daddr"
                }
              },
              "right": "203.0.113.2"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "dport"
                }
              },
              "right": 8080
            }
          },
          {
            "dnat": {
              "addr": "198.51.100.2",
              "port": 9000
            }
          }
        ]
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "netlib_nat",
        "chain": "postrouting",
        "handle": 4,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "saddr"
                }
              },
              "right": "192.0.2.2"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "daddr"
                }
              },
              "right": "198.51.100.2"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "sport"
                }
              },
              "right": 41000
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "dport"
                }
              },
              "right": 9000
            }
          },
          {
            "snat": {
              "addr": "203.0.113.1",
              "port": 40000
            }
          }
        ]
      }
    }
  ]
}
