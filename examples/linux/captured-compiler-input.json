{"nftables":
 [{"metainfo":
   {"version": "1.1.3",
    "release_name": "Netlib compiler",
    "json_schema_version": 1}},
  {"table": {"name": "netlib", "handle": 1, "family": "ip"}},
  {"chain":
   {"type": "filter",
    "table": "netlib",
    "prio": 0,
    "policy": "drop",
    "name": "forward",
    "hook": "forward",
    "handle": 2,
    "family": "ip"}},
  {"rule":
   {"table": "netlib",
    "handle": 3,
    "family": "ip",
    "expr":
    [{"match":
      {"right": {"prefix": {"len": 24, "addr": "10.0.0.0"}},
       "op": "==",
       "left": {"payload": {"protocol": "ip", "field": "saddr"}}}},
     {"match": {"right": 6, "op": "==", "left": {"meta": {"key": "l4proto"}}}},
     {"match":
      {"right": {"range": [443, 444]},
       "op": "==",
       "left": {"payload": {"protocol": "tcp", "field": "dport"}}}},
     {"accept": null}],
    "comment": "WEB",
    "chain": "forward"}},
  {"rule":
   {"table": "netlib",
    "handle": 4,
    "family": "ip",
    "expr":
    [{"match": {"right": 17, "op": "==", "left": {"meta": {"key": "l4proto"}}}},
     {"match":
      {"right": 53,
       "op": "==",
       "left": {"payload": {"protocol": "udp", "field": "dport"}}}},
     {"accept": null}],
    "comment": "DNS",
    "chain": "forward"}},
  {"rule":
   {"table": "netlib",
    "handle": 5,
    "family": "ip",
    "expr":
    [{"match": {"right": 1, "op": "==", "left": {"meta": {"key": "l4proto"}}}},
     {"accept": null}],
    "comment": "ICMP",
    "chain": "forward"}}]}